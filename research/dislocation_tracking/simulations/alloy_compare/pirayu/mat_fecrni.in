# material FeCrNi -- rutas corregidas para pirayu
variable a0 equal 3.56
lattice fcc 3.56
region box block 0 28 0 28 0 28
create_box 3 box
create_atoms 1 box
set type 1 type/fraction 2 0.33333 ${seed}
variable sc equal round(${seed})+20011
set type 1 type/fraction 3 0.50000 ${sc}
mass 1 55.845    # Fe
mass 2 58.6934    # Ni
mass 3 51.9961    # Cr
pair_style eam/alloy
pair_coeff * * FeNiCr_eam.alloy Fe Ni Cr
